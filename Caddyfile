# Nullbyte Labs — static site served by Caddy behind a Cloudflare Tunnel.
# The tunnel terminates TLS at Cloudflare's edge, so Caddy listens plain HTTP
# on the internal Docker network only. Nothing is published to the host.

:8080 {
	root * /srv
	encode zstd gzip
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		# Cloudflare adds HSTS at the edge; these are the ones it does not.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://i.ytimg.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; frame-src https://www.youtube-nocookie.com; base-uri 'none'; form-action 'none'; object-src 'none'"
		-Server
	}

	@static path /static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output stdout
		format console
	}
}
